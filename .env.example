# Copy to .env and adjust. The committed defaults are throwaway local values only.
# .env is git-ignored and must never contain real credentials.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally

PROPOSAL_DB_NAME=proposals
CONTRACT_DB_NAME=contracts

PROPOSAL_API_PORT=5101
CONTRACT_API_PORT=5102

# ContractService -> ProposalService call budget (see docs/06 and DEC-001).
PROPOSAL_API_TIMEOUT_SECONDS=2
PROPOSAL_API_ATTEMPT_TIMEOUT_SECONDS=0.8
PROPOSAL_API_RETRY_COUNT=1

# Local convenience only; production applies migrations as a separate step.
DATABASE_MIGRATE_ON_STARTUP=true
